{
  "name": "gender-it-education-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @gender-platform/api --filter @gender-platform/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,html}\" .prettierrc.json package.json pnpm-workspace.yaml docker-compose.yml",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,html}\" .prettierrc.json package.json pnpm-workspace.yaml docker-compose.yml"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.6"
  }
}
